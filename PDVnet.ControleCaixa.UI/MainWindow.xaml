<Window x:Class="PDVnet.ControleCaixa.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDVnet.ControleCaixa.UI" xmlns:viewmodels="clr-namespace:PDVnet.ControleCaixa.UI.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MovimentacaoViewModel}"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>

                <RowDefinition Height="20"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="20"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="20"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <Border
            Grid.Row="0"
            Padding="15"
            BorderBrush="LightGray"
            BorderThickness="1"
            CornerRadius="5">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock
                        FontWeight="SemiBold"
                        Text="Saldo Atual"/>

                        <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Text="{Binding SaldoAtual,StringFormat={}{0:C2}}"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1">

                        <TextBlock
                        FontWeight="SemiBold"
                        Text="Movimentações"/>

                        <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Text="{Binding TotalMovimentacoes}"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <TextBlock
                        FontWeight="SemiBold"
                        Text="Status"/>

                        <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{Binding CorStatusCaixa}"
                        Text="{Binding StatusCaixa}"/>

                    </StackPanel>

                </Grid>

            </Border>

            <GroupBox
            Grid.Row="2"
            Header="Cadastro de Movimentação">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                    Grid.Row="0"
                    Text="Descrição:"
                    VerticalAlignment="Center"/>

                    <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5"
                    IsEnabled="{Binding PodeEditar}"
                    Text="{Binding Movimentacao.Descricao}"/>

                    <TextBlock
                    Grid.Row="1"
                    Text="Tipo:"
                    VerticalAlignment="Center"/>

                    <ComboBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5"
                    IsEnabled="{Binding PodeEditar}"
                    ItemsSource="{Binding TiposMovimentacao}"
                    SelectedItem="{Binding Movimentacao.Tipo}"/>

                    <TextBlock
                    Grid.Row="2"
                    Text="Categoria:"
                    VerticalAlignment="Center"/>

                    <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="5"
                    IsEnabled="{Binding PodeEditar}"
                    Text="{Binding Movimentacao.Categoria}"/>

                    <TextBlock
                    Grid.Row="3"
                    Text="Valor:"
                    VerticalAlignment="Center"/>

                    <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="5"
                    PreviewTextInput="Valor_PreviewTextInput"
                    IsEnabled="{Binding PodeEditar}"
                    Text="{Binding Movimentacao.Valor}"/>

                    <StackPanel
                    Grid.Row="4"
                    Grid.ColumnSpan="2"
                    Margin="0,15,0,0"
                    Orientation="Horizontal">

                        <Button
                        Width="170"
                        Margin="0,0,10,0"
                        Content="Nova Movimentação"
                        Command="{Binding NovaMovimentacaoCommand}"
                        IsEnabled="{Binding PodeCriarNovaMovimentacao}"/>

                        <Button
                        Width="100"
                        Margin="0,0,10,0"
                        Content="Salvar"
                        Command="{Binding SalvarCommand}"
                        IsEnabled="{Binding MostrarSalvar}"/>

                        <Button
                        Width="100"
                        Margin="0,0,10,0"
                        Content="Atualizar"
                        Command="{Binding AtualizarCommand}"
                        IsEnabled="{Binding MostrarAtualizar}"/>

                        <Button
                        Width="100"
                        Content="Excluir"
                        Command="{Binding ExcluirCommand}"
                        IsEnabled="{Binding MostrarExcluir}"/>

                    </StackPanel>

                </Grid>

            </GroupBox>

            <GroupBox
            Grid.Row="4"
            Header="Filtros">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="180"/>

                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="180"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Data Inicial"/>

                    <DatePicker
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5"
                    SelectedDate="{Binding DataInicial}"/>

                    <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="Data Final"/>

                    <DatePicker
                    Grid.Row="0"
                    Grid.Column="3"
                    Margin="5"
                    SelectedDate="{Binding DataFinal}"/>

                    <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Tipo"/>

                    <ComboBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5"
                    ItemsSource="{Binding TiposFiltro}"
                    SelectedItem="{Binding TipoFiltro}"
                    DisplayMemberPath="Descricao"/>

                    <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="Categoria"/>

                    <TextBox
                    Grid.Row="1"
                    Grid.Column="3"
                    Margin="5"
                    Text="{Binding CategoriaFiltro}"/>

                    <StackPanel
                    Grid.Row="2"
                    Grid.ColumnSpan="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

                        <Button
                        Width="100"
                        Margin="0,0,10,0"
                        Content="Pesquisar"
                        Command="{Binding PesquisarCommand}"/>

                        <Button
                        Width="100"
                        Content="Limpar"
                        Command="{Binding LimparFiltrosCommand}"/>

                    </StackPanel>

                </Grid>

            </GroupBox>

            <DataGrid
            Grid.Row="6"
            Margin="0,10,0,0"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Movimentacoes}"
            SelectedItem="{Binding MovimentacaoSelecionada}">

                <DataGrid.Columns>

                    <DataGridTextColumn
                    Header="Descrição"
                    Binding="{Binding Descricao}"
                    Width="*"/>

                    <DataGridTextColumn
                    Header="Tipo"
                    Binding="{Binding Tipo}"
                    Width="100"/>

                    <DataGridTextColumn
                    Header="Categoria"
                    Binding="{Binding Categoria}"
                    Width="180"/>

                    <DataGridTextColumn
                    Header="Valor"
                    Binding="{Binding Valor,StringFormat={}{0:C2}}"
                    Width="120"/>

                    <DataGridTextColumn
                    Header="Data Movimento"
                    Binding="{Binding DataMovimento,StringFormat=dd/MM/yyyy HH:mm}"
                    Width="170"/>

                </DataGrid.Columns>

            </DataGrid>

        </Grid>

    </ScrollViewer>
</Window>
