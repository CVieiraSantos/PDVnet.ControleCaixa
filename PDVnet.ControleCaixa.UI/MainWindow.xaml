<Window x:Class="PDVnet.ControleCaixa.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PDVnet.ControleCaixa.UI" xmlns:viewmodels="clr-namespace:PDVnet.ControleCaixa.UI.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MovimentacaoViewModel}"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Dashboard -->
            <RowDefinition Height="20"/>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="20"/>

            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- DASHBOARD -->

        <Border
        Grid.Row="0"
        Grid.ColumnSpan="2"
        Padding="15"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="5">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Saldo -->

                <StackPanel>

                    <TextBlock
                    FontWeight="SemiBold"
                    Text="Saldo Atual"/>

                    <TextBlock
                    FontSize="18"
                    FontWeight="Bold"
                    Text="{Binding SaldoAtual,
                                   StringFormat={}{0:C2}}"/>

                </StackPanel>

                <!-- Total -->

                <StackPanel Grid.Column="1">

                    <TextBlock
                    FontWeight="SemiBold"
                    Text="Movimentações"/>

                    <TextBlock
                    FontSize="18"
                    FontWeight="Bold"
                    Text="{Binding TotalMovimentacoes}"/>

                </StackPanel>

                <!-- Status -->

                <StackPanel Grid.Column="2">

                    <TextBlock
                    FontWeight="SemiBold"
                    Text="Status"/>

                    <TextBlock
                     FontSize="18"
                     FontWeight="Bold"
                     Foreground="{Binding CorStatusCaixa}"
                     Text="{Binding StatusCaixa}" />
                </StackPanel>

            </Grid>

        </Border>

        <!-- Descrição -->

        <TextBlock
        Grid.Row="2"
        Grid.Column="0"
        Margin="0,0,10,0"
        VerticalAlignment="Center"
        Text="Descrição:"/>

        <TextBox
        Grid.Row="2"
        Grid.Column="1"
        MinWidth="250"
        Height="28"
        Margin="0,0,0,10"
        VerticalContentAlignment="Center"
        IsEnabled="{Binding PodeEditar}"
        Text="{Binding Movimentacao.Descricao,
                       UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Tipo -->

        <TextBlock
        Grid.Row="3"
        Grid.Column="0"
        Margin="0,0,10,0"
        VerticalAlignment="Center"
        Text="Tipo:"/>

        <ComboBox
        Grid.Row="3"
        Grid.Column="1"
        MinWidth="250"
        Height="28"
        Margin="0,0,0,10"
        VerticalContentAlignment="Center"
        IsEnabled="{Binding PodeEditar}"
        ItemsSource="{Binding TiposMovimentacao}"
        SelectedItem="{Binding Movimentacao.Tipo}"/>

        <!-- Categoria -->

        <TextBlock
        Grid.Row="4"
        Grid.Column="0"
        Margin="0,0,10,0"
        VerticalAlignment="Center"
        Text="Categoria:"/>

        <TextBox
        Grid.Row="4"
        Grid.Column="1"
        MinWidth="250"
        Height="28"
        Margin="0,0,0,10"
        VerticalContentAlignment="Center"
        IsEnabled="{Binding PodeEditar}"
        Text="{Binding Movimentacao.Categoria,
                       UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Valor -->

        <TextBlock
        Grid.Row="5"
        Grid.Column="0"
        Margin="0,0,10,0"
        VerticalAlignment="Center"
        Text="Valor:"/>

        <TextBox
        Grid.Row="5"
        Grid.Column="1"
        MinWidth="250"
        Height="28"
        Margin="0,0,0,10"
        VerticalContentAlignment="Center"
        IsEnabled="{Binding PodeEditar}"
        Text="{Binding Movimentacao.Valor,
                       UpdateSourceTrigger=LostFocus}"/>

        <!-- Botões -->

        <StackPanel
        Grid.Row="6"
        Grid.ColumnSpan="2"
        Orientation="Horizontal">

            <Button
            Width="170"
            Height="28"
            Margin="0,0,10,0"
            Content="Nova Movimentação"
            Command="{Binding NovaMovimentacaoCommand}"
            IsEnabled="{Binding PodeCriarNovaMovimentacao}"/>

            <Button
            Width="100"
            Height="28"
            Margin="0,0,10,0"
            Content="Salvar"
            Command="{Binding SalvarCommand}"
            IsEnabled="{Binding MostrarSalvar}"/>

            <Button
            Width="100"
            Height="28"
            Margin="0,0,10,0"
            Content="Atualizar"
            Command="{Binding AtualizarCommand}"
            IsEnabled="{Binding MostrarAtualizar}"/>

            <Button
            Width="100"
            Height="28"
            Content="Excluir"
            Command="{Binding ExcluirCommand}"
            IsEnabled="{Binding MostrarExcluir}"/>

        </StackPanel>

        <!-- DataGrid -->

        <DataGrid
        Grid.Row="8"
        Grid.ColumnSpan="2"
        Margin="0,10,0,0"
        AutoGenerateColumns="False"
        IsReadOnly="True"
        ItemsSource="{Binding Movimentacoes}"
        SelectedItem="{Binding MovimentacaoSelecionada}">

            <DataGrid.Columns>

                <DataGridTextColumn
                Header="Descrição"
                Binding="{Binding Descricao}"
                Width="*"/>

                <DataGridTextColumn
                Header="Tipo"
                Binding="{Binding Tipo}"
                Width="120"/>

                <DataGridTextColumn
                Header="Categoria"
                Binding="{Binding Categoria}"
                Width="180"/>

                <DataGridTextColumn
                Header="Valor"
                Binding="{Binding Valor, StringFormat={}{0:C2}}"
                Width="120"/>

                <DataGridTextColumn
                Header="Data Movimento"
                Binding="{Binding DataMovimento, StringFormat=dd/MM/yyyy HH:mm}"
                Width="170"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Window>
